// Diagramma della topologia di demo (sorgente Graphviz).
// Render: dot -Tpng -Gdpi=170 topologia.dot -o img/00_topologia.png
graph topo {
    rankdir=LR;
    bgcolor="white";
    splines=true;
    nodesep=0.5;
    ranksep=0.9;
    node [fontname="Helvetica", fontsize=12];
    edge [fontname="Helvetica", fontsize=10, color="#5a7286", penwidth=1.4];

    // Host di estremità
    pc1 [shape=box, style="filled,rounded", fillcolor="#e8f0fe", color="#2f80b8",
         label="pc1\n10.0.1.100"];
    pc2 [shape=box, style="filled,rounded", fillcolor="#e8f0fe", color="#2f80b8",
         label="pc2\n10.0.4.100"];

    // R1 = crouter (evidenziato); R2/R3/R4 = FRR
    R1 [shape=box, style="filled", fillcolor="#0b3d5c", fontcolor="white",
        color="#0b3d5c", penwidth=2, label="R1\ncrouter"];
    R2 [shape=ellipse, style="filled", fillcolor="#dfe7ee", color="#8aa2b4",
        label="R2\nFRR"];
    R3 [shape=ellipse, style="filled", fillcolor="#dfe7ee", color="#8aa2b4",
        label="R3\nFRR"];
    R4 [shape=ellipse, style="filled", fillcolor="#dfe7ee", color="#8aa2b4",
        label="R4\nFRR"];

    // LAN di estremità
    pc1 -- R1 [label="10.0.1.0/24"];
    R3  -- pc2 [label="10.0.4.0/24"];

    // Nucleo con cammino ridondante: R1-R2-R3 e R1-R4-R3
    R1 -- R2 [label="10.0.12.0/30"];
    R2 -- R3 [label="10.0.23.0/30"];
    R1 -- R4 [label="10.0.14.0/30"];
    R4 -- R3 [label="10.0.34.0/30"];
}
